{
  "name": "recruitgpt-local-helper",
  "version": "0.1.0",
  "private": true,
  "description": "Thin local executor: carries out generic browser primitives for RecruitGPT.ai in YOUR signed-in browser. Contains no recruiting logic.",
  "type": "module",
  "bin": { "recruitgpt-helper": "dist/index.js" },
  "scripts": {
    "start": "tsx src/index.ts run",
    "pair": "tsx src/index.ts pair",
    "chrome": "tsx src/index.ts chrome",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": { "playwright-core": "^1.50.0", "ws": "^8.18.0", "zod": "^4.0.0" },
  "devDependencies": { "@types/node": "^22.0.0", "@types/ws": "^8.5.0", "tsx": "^4.19.0", "typescript": "^5.6.0" }
}
