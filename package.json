{
  "name": "recruitgpt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3009",
    "build": "prisma generate && next build",
    "start": "next start -p 3009",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "worker": "node --env-file=.env --import tsx worker/index.ts",
    "test": "node --env-file=.env --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "import:sqlite": "node --env-file=.env --import tsx scripts/import-sqlite.ts",
    "backup": "node --env-file=.env --import tsx scripts/backup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^11.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "docx": "^9.11.0",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "googleapis": "^186.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "next": "^15.5.28",
    "nodemailer": "^10.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.0.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "postcss": "^8.5.30",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
